# Salin file ini menjadi ".env", lalu isi nilainya.
# Alamat database PostgreSQL.
#  - Uji coba lokal: jalankan "npm run db:lokal", lalu pakai alamat TCP yang tampil.
#  - Neon (produksi): DATABASE_URL = alamat "pooled" (ada kata -pooler),
#                     DIRECT_URL   = alamat langsung (tanpa -pooler), dipakai migrasi.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# DIRECT_URL=""

# Rahasia untuk menandatangani cookie login (minimal 32 karakter acak).
# Buat dengan perintah:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESI_RAHASIA=""

# Akun admin (dibuat dengan: npm run admin -- buat)
ADMIN_EMAIL="admin@kds.um.ac.id"
ADMIN_NAMA="Admin SDM"
# Sandi awal, minimal 10 karakter. HAPUS baris ini setelah akun dibuat dan sandi diganti.
ADMIN_SANDI_AWAL=""
